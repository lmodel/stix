<https://w3id.org/lmodel/stix/stix_binary> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixBinary"^^xsd:anyURI ;
	linkml:description "Bytes encoded in base64, as RFC 4648 specifies." ;
	linkml:pattern "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{4}|[A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2}==)$" ;
	linkml:typeof <https://w3id.org/lmodel/stix/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#base64Binary"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/stix_hex> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixHex"^^xsd:anyURI ;
	linkml:description "Octets encoded as an even number of hexadecimal digits." ;
	linkml:pattern "^([a-fA-F0-9]{2})+$" ;
	linkml:typeof <https://w3id.org/lmodel/stix/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#hexBinary"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/stix_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixIdentifier"^^xsd:anyURI ;
	linkml:description "A STIX identifier: an object's type name, two hyphens and a UUID, such as indicator--8e2e2d2b-17d4-4cbf-938f-98ee46b3cd3f." ;
	linkml:pattern "^[a-z][a-z0-9-]+[a-z0-9]--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" ;
	linkml:typeof <https://w3id.org/lmodel/stix/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/stix_timestamp> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixTimestamp"^^xsd:anyURI ;
	linkml:description "An RFC 3339 timestamp in UTC, ending in Z, with any precision of fractional seconds." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)(\\.[0-9]+)?Z$" ;
	linkml:typeof <https://w3id.org/lmodel/stix/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/stix_timestamp_millis> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixTimestampMillis"^^xsd:anyURI ;
	linkml:description "A timestamp precise to the millisecond or finer: at least three digits of fractional seconds, as STIX requires of created and modified." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)\\.[0-9]{3,}Z$" ;
	linkml:typeof <https://w3id.org/lmodel/stix/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/stix_timestamp_seconds> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixTimestampSeconds"^^xsd:anyURI ;
	linkml:description "A timestamp precise to the second, with no fractional seconds." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)Z$" ;
	linkml:typeof <https://w3id.org/lmodel/stix/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/stop_time> a linkml:SlotDefinition ;
	skos:closeMatch "https://ontology.unifiedcyberontology.org/uco/core/endTime"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_sro"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/stix/stop_time"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/stop_time"^^xsd:anyURI ;
	linkml:description "The latest time at which the Relationship between the objects exists. If this property is a future timestamp, at the time the updated property is defined, then this represents an estimate by the producer of the intelligence of the latest time at which relationship will be asserted to be true." ;
	linkml:domain_of <https://w3id.org/lmodel/stix/StixRelationship> ;
	linkml:owner <https://w3id.org/lmodel/stix/StixRelationship> ;
	linkml:range <https://w3id.org/lmodel/stix/stix_timestamp> ;
	linkml:slot_uri "https://w3id.org/lmodel/stix/stop_time"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/street_address> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_sdo"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/stix/street_address"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/street_address"^^xsd:anyURI ;
	linkml:description "The street address that this Location describes." ;
	linkml:domain_of <https://w3id.org/lmodel/stix/StixLocation> ;
	linkml:owner <https://w3id.org/lmodel/stix/StixLocation> ;
	linkml:range <https://w3id.org/lmodel/stix/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/stix/street_address"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/subject> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_sco"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/stix/subject"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/subject"^^xsd:anyURI ;
	linkml:description "A subject, as a string; each class says of what." ;
	linkml:domain_of <https://w3id.org/lmodel/stix/StixEmailMessage> , <https://w3id.org/lmodel/stix/StixX509Certificate> ;
	linkml:owner <https://w3id.org/lmodel/stix/StixX509Certificate> ;
	linkml:range <https://w3id.org/lmodel/stix/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/stix/subject"^^xsd:anyURI .
<https://w3id.org/lmodel/stix/subject_alternative_name> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_sco"^^xsd:anyURI ;
