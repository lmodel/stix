          <aliases> @linkml:String * ;
          <first_seen> @<StixTimestamp> ? ;
          <last_seen> @<StixTimestamp> ? ;
          <operating_system_refs> @<StixSoftware> * ;
          <architecture_execution_envs> @linkml:String * ;
