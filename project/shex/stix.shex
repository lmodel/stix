}

<StixNetworkTraffic> CLOSED {
    (  $<StixNetworkTraffic_tes> (  &<StixCyberObservableObject_tes> ;
          rdf:type [ <StixCyberObservableObject> ] ? ;
          <start> @<StixTimestamp> ? ;
          <end> @<StixTimestamp> ? ;
          <src_ref> @<StixCyberObservableObject> ? ;
          <dst_ref> @<StixCyberObservableObject> ? ;
          <src_port> @linkml:Integer ? ;
