          <value> @linkml:String ;
          <type> @linkml:String
       ) ;
       rdf:type [ <StixMacAddress> ]
    )
}

<StixMalware> CLOSED {
    (  $<StixMalware_tes> (  &<StixDomainObject_tes> ;
