          <name> @linkml:String ;
          <description> @linkml:String ? ;
          <infrastructure_types> @linkml:String * ;
          <aliases> @linkml:String * ;
          <kill_chain_phases> @<StixKillChainPhase> * ;
          <first_seen> @<StixTimestamp> ? ;
          <last_seen> @<StixTimestamp> ? ;
          <type> @linkml:String
       ) ;
       rdf:type [ <StixInfrastructure> ]
    )
}

<StixIntrusionSet> CLOSED {
    (  $<StixIntrusionSet_tes> (  &<StixDomainObject_tes> ;
          rdf:type [ <StixDomainObject> ] ? ;
          <name> @linkml:String ;
          <description> @linkml:String ? ;
          <aliases> @linkml:String * ;
          <first_seen> @<StixTimestamp> ? ;
          <last_seen> @<StixTimestamp> ? ;
          <goals> @linkml:String * ;
          <resource_level> @linkml:String ? ;
          <primary_motivation> @linkml:String ? ;
          <secondary_motivations> @linkml:String * ;
          <type> @linkml:String
       ) ;
       rdf:type [ <StixIntrusionSet> ]
    )
}

