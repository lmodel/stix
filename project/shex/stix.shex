          <pattern> @linkml:String ;
          <pattern_type> @linkml:String ;
          <pattern_version> @linkml:String ? ;
          <valid_from> @<StixTimestamp> ;
          <valid_until> @<StixTimestamp> ? ;
          <kill_chain_phases> @<StixKillChainPhase> * ;
          <type> @linkml:String
       ) ;
       rdf:type [ <StixIndicator> ]
    )
}

