          <roles> @linkml:String * ;
          <name> @linkml:String ;
          <description> @linkml:String ? ;
          <identity_class> @linkml:String ? ;
          <sectors> @linkml:String * ;
          <contact_information> @linkml:String ? ;
          <type> @linkml:String
       ) ;
